{
  "info": {
    "name": "Student Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Get all students",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/students"
      }
    },
    {
      "name": "Get student by ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/students/1"
      }
    },
    {
      "name": "Create student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aditi Sharma\",\n  \"email\": \"aditi@example.com\",\n  \"course\": \"Computer Engineering\"\n}"
        },
        "url": "{{baseUrl}}/api/students"
      }
    },
    {
      "name": "Update student",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aditi Sharma\",\n  \"email\": \"aditi@example.com\",\n  \"course\": \"Information Technology\"\n}"
        },
        "url": "{{baseUrl}}/api/students/1"
      }
    },
    {
      "name": "Delete student",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/students/1"
      }
    }
  ]
}